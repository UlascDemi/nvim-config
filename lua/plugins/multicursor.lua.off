return {
  "mg979/vim-visual-multi",
  branch = "master",
  init = function()
    vim.g.VM_maps = {
      ["Add Cursor Down"] = "<C-A-Down>",
      ["Add Cursor Up"] = "<C-A-Up>",
      ["Find Under"] = "<C-n>",
      ["Find Subword Under"] = "<C-n>",
      ["Select l"] = "", -- give Shift+Right back to Vim (jump a word)
      ["Select h"] = "", -- give Shift+Left back to Vim
    }
  end,
}
